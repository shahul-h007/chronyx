# Copy this file to `admin-panel/.env` for local admin development or Vercel.
# ==============================================================================

# Core Supabase (Required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIn0.placeholder_mock_signature

# Brand Identity & Storefront Link (Optional)
VITE_STORE_NAME="CHRONYX"
VITE_STORE_TAGLINE="Handcrafted Wooden Timepieces"
VITE_STOREFRONT_URL=https://chronyx.in
VITE_CONTACT_EMAIL=hello@chronyx.in

# Localization (Optional, defaults to INR / en-IN)
VITE_CURRENCY_CODE=INR
VITE_CURRENCY_SYMBOL=₹
VITE_LOCALE=en-IN
VITE_CURRENCY_FRACTION_DIGITS=0

# Capability Mirrors (Optional)
VITE_FEATURE_REVIEWS=true
VITE_FEATURE_WISHLIST=true
VITE_FEATURE_COUPONS=true
VITE_FEATURE_PRODUCT_VERIFICATION=false
VITE_FEATURE_CERTIFICATES=false
VITE_FEATURE_PLACEMENT_GUIDE=false
VITE_FEATURE_LOCATION_PAGES=false
