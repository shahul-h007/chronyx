# ==============================================================================
# MASTER E-COMMERCE TEMPLATE — STOREFRONT ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to `.env` in the root directory for local development or Vercel.
# NOTE: All variables prefixed with `VITE_` are bundled into browser-accessible code.
# NEVER place backend secrets (e.g. service-role key, payment secret key) here!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SUPABASE (Required)
# ------------------------------------------------------------------------------
# Your client's dedicated Supabase project URL and browser-safe Anon public key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJhbm9uIn0.placeholder_mock_signature

# ------------------------------------------------------------------------------
# 2. STORE IDENTITY & CANONICAL DOMAIN (Required)
# ------------------------------------------------------------------------------
# Store display name, legal registered entity, tagline, and production URL.
VITE_STORE_NAME="CHRONYX"
VITE_STORE_TAGLINE="Handcrafted Wooden Timepieces"
VITE_STORE_LEGAL_NAME="Chronyx Atelier Private Limited"
VITE_SITE_URL=https://chronyx.in

# ------------------------------------------------------------------------------
# 3. STORE CONTACT & CUSTOMER CARE (Optional)
# ------------------------------------------------------------------------------
VITE_CONTACT_EMAIL=hello@chronyx.in
VITE_SUPPORT_EMAIL=support@chronyx.in
VITE_CONTACT_PHONE="+91 9562122618"
VITE_WHATSAPP_NUMBER="919562122618"

# ------------------------------------------------------------------------------
# 4. LOCALIZATION & CURRENCY (Optional, defaults to INR / en-IN)
# ------------------------------------------------------------------------------
# ISO 4217 Currency Code (e.g., INR, USD, EUR, GBP)
VITE_CURRENCY_CODE=INR
# Currency symbol for UI rendering (e.g., ₹, $, €, £)
VITE_CURRENCY_SYMBOL=₹
# BCP 47 Language Tag / Locale (e.g., en-IN, en-US, en-GB, fr-FR)
VITE_LOCALE=en-IN
# Decimal fraction digits (e.g., 0 for INR/JPY, 2 for USD/EUR)
VITE_CURRENCY_FRACTION_DIGITS=0
# Currency symbol position ('before' | 'after')
VITE_CURRENCY_SYMBOL_POSITION=before

# ------------------------------------------------------------------------------
# 5. VISUAL THEME SELECTION (Optional, defaults to 'chronyx')
# ------------------------------------------------------------------------------
# Supported presets: 'chronyx' (heirloom warm), 'minimal' (clean modern), 'warmEditorial' (editorial)
VITE_THEME=chronyx

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Required if online payments enabled)
# ------------------------------------------------------------------------------
# Razorpay Publishable Key ID (Client-side checkout script)
VITE_RAZORPAY_KEY_ID=rzp_test_exampleKey123

# ------------------------------------------------------------------------------
# 7. CAPABILITY TOGGLES (Optional, all default to true if omitted)
# ------------------------------------------------------------------------------
# Customer reviews & ratings on product pages
VITE_FEATURE_REVIEWS=true
# Customer wishlist / bookmarking functionality
VITE_FEATURE_WISHLIST=true
# Promo coupon codes during checkout
VITE_FEATURE_COUPONS=true
# Physical serial unit registry & QR code authenticity checks
VITE_FEATURE_PRODUCT_VERIFICATION=false
# Authenticity certificate PDF downloads
VITE_FEATURE_CERTIFICATES=false
# Interior placement and hanging height design guide (/guides/wall-clock-placement)
VITE_FEATURE_PLACEMENT_GUIDE=false
# Programmatic local city landing pages (/locations/:city)
VITE_FEATURE_LOCATION_PAGES=false
# Product showcase video embeds in gallery
VITE_FEATURE_PRODUCT_VIDEO=true
# Exit-intent discount popup modal
VITE_FEATURE_EXIT_INTENT=true
# Floating WhatsApp direct support chat widget
VITE_FEATURE_WHATSAPP_WIDGET=true

# ==============================================================================
# SERVER-SIDE SECRETS (REFERENCE ONLY — DO NOT PASTE HERE)
# ==============================================================================
# Set these strictly via Supabase CLI (`supabase secrets set`) or Vercel Environment:
# - RAZORPAY_KEY_SECRET (Used by create-razorpay-order & verify-razorpay-payment)
# - RESEND_API_KEY      (Used by send-contact-email & send-order-email)
# ==============================================================================
